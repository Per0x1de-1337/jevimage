# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging. dist/ and the egg-info are produced by `python -m build`; the sdist is
# published to PyPI, never committed.
build/
dist/
*.egg-info/
*.egg
.eggs/

# Environments
.venv/
venv/
env/
ENV/

# Testing and tooling caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Trained heads. A head is a fitted artefact, not source: it belongs to whoever ran
# the training, it is tied to the encoder that produced it, and it is regenerated by
# `jev train`. $JEV_HOME defaults to ~/.jev but a heads-dir is often local.
*.pt
heads/
.jev/

# Fixture images written by examples/make_fixtures.py. Generated on demand by the
# docs, deliberately not shipped: the script is the source, the PNGs are its output.
ds/
shots/
colours/

# Documentation build output. `mint export` writes export.zip, mkdocs writes site/.
# Both are rebuilt from docs/ and docs.json.
export.zip
.mint/
site/
node_modules/

# Secrets. Nothing in this repo should ever hold one, and this is the second line of
# defence rather than the first.
.env
.env.*
*.pem
*.key
*.p12
credentials.json

# Editors and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
